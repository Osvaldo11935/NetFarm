#Setting database
POSTGRES_USER:root
POSTGRES_PORT:5432
POSTGRES_HOST:localhost
POSTGRES_PASSWORD:123
POSTGRES_DATABASE:netfarm
POSTGRES_CONNECTION_STRING: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}?sslmode=disable

#Setting Google service
BUCKET_NAME: document-land
FILE_CONFIG_GOOGLE_STORAGE: keys.json
BASE_URL_GOOGLE_STORAGE: https://storage.googleapis.com

PORTPORT:8000

POSTGRES_CONNECTION_STRING: postgresql://netfarm:netfarm123m@ec2-100-59-192-203.compute-1.amazonaws.com:5432/netfarm?sslmode=disable
sudo docker run -d \
  --name postgres \
  --restart unless-stopped \
  -e POSTGRES_USER=netfarm \
  -e POSTGRES_PASSWORD='netfarm123m' \
  -e POSTGRES_DB=netfarm \
  -p 5432:5432 \
  -v postgres_data:/var/lib/postgresql \
  postgres:18